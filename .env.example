# Copia este archivo a .env y rellena lo que necesites. El .env no se sube:
# está en .gitignore, y ahí es donde tiene que quedarse un secreto.
#
# Nada de esto es obligatorio para arrancar. Sin claves, /index.html y
# /predicciones.html funcionan con APIs públicas y /acciones.html con datos
# de ejemplo.

# Acciones. Cuenta gratuita en https://app.alpaca.markets/ -> API Keys.
# Valen tanto las de papel como las reales. El secreto sólo se enseña al
# crear la clave: si no lo guardaste, genera otra.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# iex es gratis y de un solo mercado; sip es la cinta consolidada, de pago.
# ALPACA_FEED=iex

# Puerto del servidor.
# PORT=3000
