diff --git a/test/kalshi-order-transport.test.js b/test/kalshi-order-transport.test.js
new file mode 100644
index 0000000..1b0000a
--- /dev/null
+++ b/test/kalshi-order-transport.test.js
@@ -0,0 +1,239 @@
+'use strict';
+
+// El transporte que firma y envía las órdenes.
+//
+// De todo el repositorio, éste es el archivo donde un fallo saca dinero de la
+// cuenta, y hasta ahora era uno de los dos sin pruebas. Lo que se comprueba
+// aquí es, casi todo, lo que NO debe poder hacer: enviar con la escritura
+// apagada, firmar sobre la cadena equivocada, devolver texto del proveedor sin
+// filtrar, o seguir un redirect con las credenciales puestas.
+
+const test = require('node:test');
+const assert = require('node:assert');
+const crypto = require('node:crypto');
+
+const { create } = require('../src/kalshi-order-transport');
+
+const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
+
+// Un `fetch` de mentira que apunta lo que recibió.
+function fetchFalso(respuesta = { ok: true, json: async () => ({ ok: true }) }) {
+  const llamadas = [];
+  const impl = async (url, opciones) => { llamadas.push({ url, opciones }); return respuesta; };
+  impl.llamadas = llamadas;
+  return impl;
+}
+
+const bot = (extra = {}) => create({
+  environment: 'demo', keyId: 'clave', privateKey,
+  allowWrites: true, role: 'bot', clock: () => 1_700_000_000_000,
+  ...extra,
+});
+
+// --- Lo que no debe poder hacer --------------------------------------------
+
+test('con la escritura apagada no se envía una orden', async () => {
+  // Es el estado por defecto del módulo, y tiene que seguir siéndolo: que
+  // alguien lo importe no puede bastar para que opere.
+  const t = create({ environment: 'demo', keyId: 'k', privateKey, fetchImpl: fetchFalso() });
+  await assert.rejects(() => t.submit({ x: 1 }), /desactivado/);
+  await assert.rejects(() => t.cancel('abc', 'TICK'), /desactivado/);
+});
+
+test('hacen falta LAS DOS condiciones: permiso de escritura y papel de bot', async () => {
+  // Con una sola bastaría que se colara un flag por descuido.
+  const soloPermiso = create({ environment: 'demo', keyId: 'k', privateKey, allowWrites: true, fetchImpl: fetchFalso() });
+  await assert.rejects(() => soloPermiso.submit({}), /desactivado/, 'permiso sin papel de bot');
+
+  const soloPapel = create({ environment: 'demo', keyId: 'k', privateKey, role: 'bot', fetchImpl: fetchFalso() });
+  await assert.rejects(() => soloPapel.submit({}), /desactivado/, 'papel de bot sin permiso');
+});
+
+test('leer sí se puede con la escritura apagada', async () => {
+  const f = fetchFalso();
+  const t = create({ environment: 'demo', keyId: 'k', privateKey, fetchImpl: f });
+  await t.read('/markets');
+  assert.equal(f.llamadas.length, 1);
+  assert.equal(f.llamadas[0].opciones.method, 'GET');
+});
+
+test('sin credenciales no se firma nada', async () => {
+  const t = create({ environment: 'demo', allowWrites: true, role: 'bot', fetchImpl: fetchFalso() });
+  await assert.rejects(() => t.submit({}), /Credenciales/);
+});
+
+test('un entorno que no está en la lista se rechaza al construir', () => {
+  assert.throws(() => create({ environment: 'produccion-de-verdad' }), /Entorno no permitido/);
+  assert.throws(() => create({ environment: '__proto__' }), /Entorno no permitido/);
+});
+
+test('una ruta de lectura con salto de directorio se rechaza', () => {
+  // Rechaza ANTES de salir a la red, así que lanza de forma síncrona: el error
+  // no llega a ser una promesa rechazada, y comprobarlo con `rejects` daría un
+  // falso aprobado el día que alguien quite la validación.
+  const t = create({ environment: 'demo', keyId: 'k', privateKey, fetchImpl: fetchFalso() });
+  for (const mala of ['/../admin', '/mercados/..', '\\windows', 'markets', '/Markets', '']) {
+    assert.throws(() => t.read(mala), /Ruta no permitida/, `debería rechazar «${mala}»`);
+  }
+});
+
+// --- La firma ---------------------------------------------------------------
+
+test('se firma exactamente «marca de tiempo + método + ruta»', async () => {
+  // La prueba que importa de verdad: no que haya una firma, sino que la cadena
+  // firmada sea la correcta. Una firma sobre otra cosa da 401 contra Kalshi y
+  // se diagnostica como «la clave está mal».
+  const f = fetchFalso();
+  const t = bot({ fetchImpl: f });
+  await t.submit({ ticker: 'KXBTCD-X' });
+
+  const { opciones } = f.llamadas[0];
+  const firma = Buffer.from(opciones.headers['KALSHI-ACCESS-SIGNATURE'], 'base64');
+  const marca = opciones.headers['KALSHI-ACCESS-TIMESTAMP'];
+
+  assert.equal(marca, '1700000000000', 'la marca sale del reloj inyectado');
+  assert.equal(opciones.headers['KALSHI-ACCESS-KEY'], 'clave');
+
+  const esperado = marca + 'POST' + '/trade-api/v2/portfolio/events/orders';
+  assert.ok(
+    crypto.verify('sha256', Buffer.from(esperado), {
+      key: publicKey,
+      padding: crypto.constants.RSA_PKCS1_PSS_PADDING,
+      saltLength: crypto.constants.RSA_PSS_SALTLEN_DIGEST,
+    }, firma),
+    'la firma no valida sobre marca+método+ruta',
+  );
+
+  // Y no sobre otra cosa parecida, que es el error clásico.
+  for (const casi of [marca + 'POST' + '/portfolio/events/orders', marca + '/trade-api/v2/portfolio/events/orders', 'POST' + marca + '/trade-api/v2/portfolio/events/orders']) {
+    assert.ok(!crypto.verify('sha256', Buffer.from(casi), {
+      key: publicKey, padding: crypto.constants.RSA_PKCS1_PSS_PADDING, saltLength: crypto.constants.RSA_PSS_SALTLEN_DIGEST,
+    }, firma), `no debería validar sobre «${casi}»`);
+  }
+});
+
+test('la ruta firmada no lleva la query', async () => {
+  // Se firma `url.pathname`. Si Kalshi esperase la query dentro, cancelar
+  // fallaría siempre y sólo al cancelar: el peor momento para descubrirlo.
+  const f = fetchFalso();
+  await bot({ fetchImpl: f }).cancel('ord-1', 'KXBTCD-X');
+
+  const { url, opciones } = f.llamadas[0];
+  assert.match(String(url), /market_ticker=KXBTCD-X/, 'la query sí viaja en la URL');
+
+  const esperado = opciones.headers['KALSHI-ACCESS-TIMESTAMP'] + 'DELETE' + '/trade-api/v2/portfolio/events/orders/ord-1';
+  assert.ok(crypto.verify('sha256', Buffer.from(esperado), {
+    key: publicKey, padding: crypto.constants.RSA_PKCS1_PSS_PADDING, saltLength: crypto.constants.RSA_PSS_SALTLEN_DIGEST,
+  }, Buffer.from(opciones.headers['KALSHI-ACCESS-SIGNATURE'], 'base64')));
+});
+
+test('cada petición se firma con su propia marca de tiempo', async () => {
+  let t = 1_700_000_000_000;
+  const f = fetchFalso();
+  const tr = bot({ fetchImpl: f, clock: () => (t += 1000) });
+  await tr.read('/markets');
+  await tr.read('/markets');
+  assert.notEqual(f.llamadas[0].opciones.headers['KALSHI-ACCESS-TIMESTAMP'], f.llamadas[1].opciones.headers['KALSHI-ACCESS-TIMESTAMP']);
+});
+
+// --- La red -----------------------------------------------------------------
+
+test('no se siguen redirecciones con las credenciales puestas', async () => {
+  // Seguir un 302 reenviaría las cabeceras firmadas a donde diga el servidor.
+  const f = fetchFalso();
+  await bot({ fetchImpl: f }).read('/markets');
+  assert.equal(f.llamadas[0].opciones.redirect, 'error');
+  assert.ok(f.llamadas[0].opciones.signal, 'y hay tiempo máximo');
+});
+
+test('un error HTTP no devuelve el cuerpo del proveedor', async () => {
+  // El cuerpo de Kalshi puede traer datos de la cuenta. Sale el código y nada
+  // más, y sólo si tiene forma de código.
+  const t = bot({ fetchImpl: fetchFalso({
+    ok: false, status: 400,
+    json: async () => ({ error: { code: 'insufficient_balance', message: 'Saldo 123,45 USD en la cuenta 99' } }),
+  }) });
+
+  await assert.rejects(() => t.submit({}), (err) => {
+    assert.equal(err.httpStatus, 400);
+    assert.equal(err.providerCode, 'insufficient_balance');
+    assert.doesNotMatch(err.message, /123,45|cuenta 99/, 'no se filtra el cuerpo');
+    assert.match(err.message, /reconciliar antes de repetir/);
+    return true;
+  });
+});
+
+test('un código de proveedor con forma rara no se propaga', async () => {
+  const t = bot({ fetchImpl: fetchFalso({
+    ok: false, status: 500,
+    json: async () => ({ code: 'esto tiene espacios y <etiquetas>' }),
+  }) });
+  await assert.rejects(() => t.submit({}), (err) => {
+    assert.equal(err.providerCode, undefined, 'sólo códigos con forma de código');
+    return true;
+  });
+});
+
+test('un cuerpo de error ilegible no esconde el fallo', async () => {
+  const t = bot({ fetchImpl: fetchFalso({ ok: false, status: 502, json: async () => { throw new Error('no es json'); } }) });
+  await assert.rejects(() => t.submit({}), /502/);
+});
+
+// --- La financiación de demo ------------------------------------------------
+
+test('la financiación ficticia sólo existe en demo y por menos de un dólar', async () => {
+  const f = fetchFalso();
+  const demo = bot({ fetchImpl: f });
+  await demo.fundDemoShard({ destination: 1, amountUSD: 1 });
+  assert.equal(f.llamadas.length, 1);
+
+  // Igual que arriba: la validación lanza antes de tocar la red.
+  for (const malo of [
+    { destination: 1, amountUSD: 2 },
+    { destination: 1, amountUSD: 0 },
+    { destination: 1, amountUSD: -1 },
+    { destination: 0, amountUSD: 1 },
+    { destination: 101, amountUSD: 1 },
+    { destination: 1.5, amountUSD: 1 },
+    { destination: 1, amountUSD: 0.000001 },
+  ]) {
+    assert.throws(() => demo.fundDemoShard(malo), /Solo financiación demo/, JSON.stringify(malo));
+  }
+
+  const prod = create({ environment: 'production', keyId: 'k', privateKey, allowWrites: true, role: 'bot', fetchImpl: fetchFalso() });
+  assert.throws(() => prod.fundDemoShard({ destination: 1, amountUSD: 1 }), /Solo financiación demo/);
+});
+
+// --- Buscar una orden por su identificador propio ---------------------------
+
+test('dos órdenes con el mismo identificador propio son un error, no una elección', async () => {
+  // Elegir una de las dos sería inventarse cuál es la nuestra.
+  const t = bot({ fetchImpl: async () => ({ ok: true, json: async () => ({
+    orders: [{ client_order_id: 'mia' }, { client_order_id: 'mia' }], cursor: null,
+  }) }) });
+  await assert.rejects(() => t.find('mia'), /duplicado/);
+});
+
+test('una paginación que se repite se corta, en vez de girar para siempre', async () => {
+  const t = bot({ fetchImpl: async () => ({ ok: true, json: async () => ({ orders: [], cursor: 'el-mismo' }) }) });
+  await assert.rejects(() => t.find('mia'), /Paginación repetida/);
+});
+
+test('una respuesta sin lista de órdenes no se lee como «no está»', async () => {
+  // Devolver null ahí diría «tu orden no existe» cuando lo que pasa es que no
+  // sabemos. Con una orden viva delante, eso se paga.
+  const t = bot({ fetchImpl: async () => ({ ok: true, json: async () => ({ cursor: null }) }) });
+  await assert.rejects(() => t.find('mia'), /incompleta/);
+});
+
+test('cuando de verdad no está, se dice que no está', async () => {
+  const t = bot({ fetchImpl: async () => ({ ok: true, json: async () => ({ orders: [{ client_order_id: 'otra' }], cursor: null }) }) });
+  assert.equal(await t.find('mia'), null);
+});
+
+test('consultar una orden exige que Kalshi confirme la sección del mercado', async () => {
+  // Sin `exchange_index` verificado la consulta iría a la sección equivocada y
+  // volvería vacía: otra vez «tu orden no existe» siendo mentira.
+  const t = bot({ fetchImpl: async () => ({ ok: true, json: async () => ({ market: { exchange_index: null } }) }) });
+  await assert.rejects(() => t.get('ord-1', 'KXBTCD-X'), /sección de mercado no verificada/i);
+});
